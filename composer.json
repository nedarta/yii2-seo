{
    "name": "nedarta/yii2-seo",
    "description": "SEO metadata behavior for Yii2 ActiveRecord models with multilingual support.",
    "keywords": [
        "yii2",
        "seo",
        "behavior",
        "multilingual",
        "translation"
    ],
    "homepage": "https://github.com/nedarta/yii2-seo",
    "type": "yii2-extension",
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.1",
        "yiisoft/yii2": "^2.0",
        "lav45/yii2-translated-behavior": "^1.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "nedarta\\seo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
